                  { title: 'Computer Science Lecture', time: '9:00 AM', color: '#a855f7' },
                  { title: 'Math Assignment Due', time: '11:30 AM', color: '#ec4899' },
                  { title: 'Study Group Meeting', time: '2:00 PM', color: '#3b82f6' }
