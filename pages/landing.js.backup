              border: '1px solid rgba(168, 85, 247, 0.2)',
              borderRadius: '20px',
              padding: '0.5rem 1rem',
              marginBottom: '1.5rem',
              fontSize: '0.875rem',
              fontWeight: 600,
              color: '#7c3aed'
            }}>
              ✨ Your Academic Success Starts Here
            </div>
            
            <h1 style={{ 
              fontSize: '3.5rem', 
              fontWeight: 800, 
              lineHeight: 1.1,
              marginBottom: '1.5rem',
              background: 'linear-gradient(135deg, #1f2937 0%, #4b5563 100%)',
              WebkitBackgroundClip: 'text',
              WebkitTextFillColor: 'transparent',
              backgroundClip: 'text'
            }}>
              Plan Smarter,<br />Study Better,<br />
              <span style={{
                background: 'linear-gradient(135deg, #a855f7 0%, #7c3aed 100%)',
                WebkitBackgroundClip: 'text',
                WebkitTextFillColor: 'transparent',
                backgroundClip: 'text'
              }}>
                Achieve More
              </span>
            </h1>
            
            <p style={{ 
              fontSize: '1.25rem', 
              color: '#6b7280', 
              lineHeight: 1.7,
              marginBottom: '2rem'
            }}>
              The all-in-one platform that helps students manage courses, track assignments, and stay on top of their academic journey with beautiful, intuitive tools.
            </p>

            <div style={{ display: 'flex', gap: '1rem', marginBottom: '2rem' }}>
              <Link href="/signup" style={{
                background: 'linear-gradient(135deg, #a855f7 0%, #7c3aed 100%)',
                color: 'white',
                padding: '1rem 2rem',
                borderRadius: '12px',
                textDecoration: 'none',
                fontWeight: 600,
                fontSize: '1.125rem',
                boxShadow: '0 8px 20px rgba(168, 85, 247, 0.3)',
                transition: 'all 0.2s ease',
                display: 'inline-block'
              }} onMouseEnter={(e) => {
                e.currentTarget.style.transform = 'translateY(-2px)';
                e.currentTarget.style.boxShadow = '0 12px 28px rgba(168, 85, 247, 0.4)';
              }} onMouseLeave={(e) => {
                e.currentTarget.style.transform = 'translateY(0)';
