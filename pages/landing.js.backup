              {/* Decorative gradient */}
              <div style={{
                position: 'absolute',
                top: 0,
                left: 0,
                right: 0,
                height: '6px',
                background: 'linear-gradient(90deg, #a855f7 0%, #7c3aed 50%, #a855f7 100%)',
              }} />
              
              {/* Mock Calendar UI */}
              <div style={{ marginBottom: '1.5rem' }}>
