              borderRadius: '20px',
              padding: '2rem',
              boxShadow: '0 20px 60px rgba(168, 85, 247, 0.15)',
              border: '1px solid rgba(168, 85, 247, 0.1)',
              position: 'relative',
              overflow: 'hidden'
