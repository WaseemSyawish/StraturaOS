generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                  String              @id @default(uuid())
  email               String              @unique
  settings            Json?
  password_hash       String?
  name                String?
  password_reset_token String?
  password_reset_expires DateTime?
  created_at          DateTime?           @default(now())
  updated_at          DateTime?           @default(now())
  archived_events     ArchivedEvent[]
  attendance_sessions AttendanceSession[]
  courses             Course[]
  events              Event[]
  focus_sessions      FocusSession[]
  focus_settings      FocusSettings?
  semester_settings   SemesterSetting[]

  @@map("users")
}

model SemesterSetting {
  id         String    @id @default(uuid())
  user_id    String
  name       String
  start_date DateTime
  end_date   DateTime
  is_active  Boolean   @default(false)
  created_at DateTime? @default(now())
  updated_at DateTime? @default(now())
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_semester_settings_user")
  @@map("semester_settings")
}

model Course {
  id                  String              @id @default(uuid())
  name                String
  code                String?
  credits             Int?                @default(3)
  color               String?
  semester            String?
  instructor          String?
  description         String?
  user_id             String
  created_at          DateTime?           @default(now())
  updated_at          DateTime?           @default(now())
  course_website      String?
  office_hours        String?
  zoom_link           String?
  archived_events     ArchivedEvent[]
  assessments         Assessment[]
  attendance_sessions AttendanceSession[]
  resources           CourseResource[]
  users               User                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  events              Event[]

  @@index([user_id], map: "idx_courses_user")
  @@map("courses")
}

model Assessment {
  id         String    @id @default(uuid())
  name       String
  type       String    @default("assignment")
  weight     Float?
  items      Json?     @default("[]")
  course_id  String
  user_id    String
  created_at DateTime? @default(now())
  updated_at DateTime? @default(now())
  course     Course    @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([course_id], map: "idx_assessment_course")
  @@index([user_id], map: "idx_assessment_user")
  @@map("assessments")
}

model AttendanceSession {
  id         String            @id @default(uuid())
  date       DateTime
  status     attendance_status
  points     Int?              @default(0)
  notes      String?
  user_id    String
  course_id  String
  created_at DateTime?         @default(now())
  updated_at DateTime?         @default(now())
  courses    Course            @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      User              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([date], map: "idx_attendance_date")
  @@index([user_id, course_id], map: "idx_attendance_user_course")
  @@map("attendance_sessions")
}

model Event {
  id             String         @id @default(uuid())
  title          String
  type           String         @default("assignment")
  archived       Boolean        @default(false)
  course_id      String?
  date           DateTime
  time           String?
  description    String?
  completed      Boolean        @default(false)
  user_id        String
  created_at     DateTime?      @default(now())
  updated_at     DateTime?      @default(now())
  meta           Json?
  end_date       DateTime?
  template_id    String?
  location       String?
  reminders      String[]       @default([])
  remindersFired String[]       @default([])
  attachments    Attachment[]
  courses        Course?        @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  eventTemplate  EventTemplate? @relation(fields: [template_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          User           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([date], map: "idx_events_date")
  @@index([user_id], map: "idx_events_user")
  @@map("events")
}

model EventTemplate {
  id            String    @id @default(uuid())
  title         String
  course_id     String?
  repeat_option String?
  start_date    DateTime?
  payload       Json?
  user_id       String
  created_at    DateTime? @default(now())
  updated_at    DateTime? @default(now())
  events        Event[]

  @@index([user_id], map: "idx_event_templates_user")
  @@map("event_templates")
}

model ArchivedEvent {
  id                String    @id @default(uuid())
  original_event_id String?   @unique
  title             String
  type              String    @default("assignment")
  archived          Boolean   @default(true)
  course_id         String?
  date              DateTime
  time              String?
  description       String?
  completed         Boolean   @default(false)
  user_id           String
  created_at        DateTime? @default(now())
  updated_at        DateTime? @default(now())
  location          String?
  meta              Json?
  courses           Course?   @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users             User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([date], map: "idx_archived_events_date")
  @@index([user_id], map: "idx_archived_events_user")
  @@map("archived_events")
}

model Attachment {
  id         String    @id @default(uuid())
  filename   String
  path       String
  mime       String?
  size       Int?
  event_id   String
  created_at DateTime? @default(now())
  event      Event     @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("attachments")
}

model CourseResource {
  id         String    @id @default(uuid())
  course_id  String
  title      String
  type       String    @default("link")
  url        String?
  content    String?
  category   String?
  order      Int?      @default(0)
  created_at DateTime? @default(now())
  updated_at DateTime? @default(now())
  course     Course    @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([course_id], map: "idx_course_resources_course")
  @@map("course_resources")
}

model FocusSession {
  id           String    @id @default(uuid())
  user_id      String
  task_id      String?
  session_type String    @default("focus")
  duration     Int
  started_at   DateTime
  ended_at     DateTime?
  completed    Boolean   @default(false)
  notes        String?
  created_at   DateTime? @default(now())
  updated_at   DateTime? @default(now())
  task_name    String?
  interrupted  Boolean   @default(false)
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_focus_sessions_user")
  @@index([started_at], map: "idx_focus_sessions_date")
  @@index([task_id], map: "idx_focus_sessions_task")
  @@map("focus_sessions")
}

model FocusSettings {
  id                        String    @id @default(uuid())
  user_id                   String    @unique
  focus_duration            Int       @default(1500)
  short_break_duration      Int       @default(300)
  long_break_duration       Int       @default(900)
  sessions_until_long_break Int       @default(4)
  sound_enabled             Boolean   @default(true)
  sound_volume              Int       @default(50)
  sound_type                String    @default("chime")
  notifications_enabled     Boolean   @default(true)
  auto_start_breaks         Boolean   @default(false)
  auto_start_focus          Boolean   @default(false)
  daily_goal_sessions       Int?      @default(8)
  theme_preference          String    @default("system")
  created_at                DateTime? @default(now())
  updated_at                DateTime? @default(now())
  user                      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("focus_settings")
}

enum attendance_status {
  PRESENT
  ABSENT
  HOLIDAY
  EXCUSED
  LATE
}
